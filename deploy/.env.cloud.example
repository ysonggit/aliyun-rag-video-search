# Cloud Deployment Environment Variables
# Copy to .env.cloud and fill in your values

# ── Alibaba Cloud Credentials ─────────────────────────
# RAM user with OSS + FC + ACR permissions
OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET_NAME=rag-videos-{your-suffix}

# ── DashScope (Singapore) ─────────────────────────────
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ── DashVector (Singapore) ────────────────────────────
DASHVECTOR_API_KEY=your-dashvector-api-key
DASHVECTOR_ENDPOINT=xxx.dashvector.ap-southeast-1.aliyuncs.com

# ── ACR (Container Registry) ──────────────────────────
ACR_REGISTRY=registry.ap-southeast-1.aliyuncs.com/your-namespace

# ── Models ────────────────────────────────────────────
EMBEDDING_MODEL=tongyi-embedding-vision-plus
VL_MODEL=qwen-vl-max
DV_COLLECTION_NAME=scene_frames

# ── Security (Tier 2 hardening) ───────────────────────
# Generate strong random strings. Examples below are placeholders — NEVER commit real values.
#
#   openssl rand -hex 32

# Session password for the Streamlit UI login gate.
# If left empty, the UI is open (dev only). Set this in production.
WEBUI_PASSWORD=change-me-strong-random-string

# Shared secret injected by API Gateway as X-Internal-Token header when
# forwarding to query-service. query-service refuses /search without it.
# Must match the header configured in your API Gateway backend settings.
INTERNAL_TOKEN=change-me-different-random-string

# API key issued by Alibaba Cloud API Gateway for programmatic /search clients.
# Clients send this as `X-API-Key` header. Used by the usage plan / rate limit.
API_GATEWAY_KEY=change-me-yet-another-random-string

# ── Custom domain (optional, for TLS + WAF) ───────────
# If you have a domain pointing at Alibaba Cloud, set it here.
# Leave empty to use the default *.fc.app endpoint.
CUSTOM_DOMAIN=
CDN_CERT_ID=
