# Cloud Deployment Environment Variables
# Copy to .env.cloud and fill in your values

# ── Alibaba Cloud Credentials ─────────────────────────
# RAM user with OSS + FC + ACR permissions
OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET_NAME=rag-videos-{your-suffix}

# ── DashScope (Singapore) ─────────────────────────────
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ── DashVector (Singapore) ────────────────────────────
DASHVECTOR_API_KEY=your-dashvector-api-key
DASHVECTOR_ENDPOINT=xxx.dashvector.ap-southeast-1.aliyuncs.com

# ── ACR (Container Registry) ──────────────────────────
ACR_REGISTRY=registry.ap-southeast-1.aliyuncs.com/your-namespace

# ── Models ────────────────────────────────────────────
EMBEDDING_MODEL=tongyi-embedding-vision-plus
VL_MODEL=qwen-vl-max
DV_COLLECTION_NAME=scene_frames
