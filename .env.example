# ============================================
# Alibaba Cloud DashScope (百炼) Configuration
# ============================================
# Default endpoint: https://dashscope.aliyuncs.com/api/v1
# Singapore/intl:   https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Get API Key from: https://bailian.console.aliyun.com/ -> API-KEY Management
# Note: Singapore endpoint requires an API key from the international console
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ============================================
# DashVector Configuration
# ============================================
# Get from: https://dashvector.console.aliyun.com/ -> Cluster Details
DASHVECTOR_API_KEY=your-dashvector-api-key
DASHVECTOR_ENDPOINT=your-cluster-endpoint.dashvector.cn-hangzhou.aliyuncs.com

# ============================================
# OSS Configuration (for video/frame storage)
# ============================================
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_FRAME_PREFIX=video-frames

# ============================================
# Model Configuration
# ============================================
# Embedding model: tongyi-embedding-vision-plus (1152 dim, independent vectors only)
# Alternative: qwen3-vl-embedding (256-2560 dim, supports independent via enable_fusion=False)
EMBEDDING_MODEL=tongyi-embedding-vision-plus

# Vision-Language model for structured scene captioning
# Options: qwen-vl-max, qwen3-vl-plus, qwen3-vl-flash
VL_MODEL=qwen-vl-max

# DashVector collection name
DV_COLLECTION_NAME=scene_frames

# Vector dimension (must match embedding model output)
# tongyi-embedding-vision-plus: 1152 (fixed)
# qwen3-vl-embedding: 256/512/768/1024/1536/2048/2560
VECTOR_DIMENSION=1152

# ============================================
# Project Paths
# ============================================
# EPIC-KITCHENS annotation directory (clone from GitHub)
EPIC_ANNOTATIONS_DIR=/tmp/epic-kitchens-100-annotations

# Local storage paths
# Videos downloaded by epic_downloader go to EPIC-KITCHENS/P01/videos/
VIDEO_STORAGE_DIR=EPIC-KITCHENS
FRAME_STORAGE_DIR=storage/frames

# Frame extraction settings
EXTRACT_FPS=0.5
FRAME_QUALITY=90
